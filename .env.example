# Run `uv run veil init` to create a private .env with real secrets.
# Do not copy a password hash or secret key from another installation.
VEIL_PASSWORD_HASH=
VEIL_SECRET_KEY=

# Paths are relative to the process working directory unless absolute.
VEIL_DATA_DIR=data
VEIL_MODEL_PATH=models/yunet.onnx

# Integer GiB, 1..100. Default: 8 GiB per upload.
VEIL_MAX_UPLOAD_GB=8
VEIL_MODE=auto
VEIL_HOST=127.0.0.1
VEIL_PORT=8765

# true for Tailscale Serve HTTPS; false for local http://127.0.0.1 testing.
VEIL_SECURE_COOKIE=false

# Public HTTPS origin for reverse-proxy deployments. No trailing path.
# Set this to the URL printed by `tailscale serve status` when using Docker.
VEIL_ORIGIN=

# Comma-separated IPs allowed to supply forwarded request headers.
# Keep the loopback default for native Tailscale Serve; do not use '*'.
VEIL_TRUSTED_PROXIES=127.0.0.1
